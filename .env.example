# Copy this file to .env and fill it in. .env never goes to GitHub.

# Browser where you are logged into instagram.com with a burner account: chrome, firefox, safari, edge or brave
IG_COOKIES_FROM=chrome

# Claude key for the written audit (console.anthropic.com -> API Keys). Leave empty for metrics only.
ANTHROPIC_API_KEY=

# How many recent posts to read per account
MAX_POSTS=100

# 1 = also download reels, transcribe the audio and look at frames (better audit, a few minutes slower)
VIDEO_ANALYSIS=0

# 0 = free mode: metrics + quick insights only, no Claude API calls
USE_AI=0
